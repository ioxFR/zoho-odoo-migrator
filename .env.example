# =========================
# Zoho Books configuration
# =========================
# Data center (defaults to eu)
ZOHO_DATA_CENTER=eu

# OAuth refresh-token flow credentials (required)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# Optional overrides (EU defaults already applied)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu/oauth/v2/token
ZOHO_API_BASE_URL=https://www.zohoapis.eu/books/v3

# Pagination and HTTP behavior
ZOHO_PAGE_SIZE=200
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRY_TOTAL=5
HTTP_RETRY_BACKOFF_FACTOR=1.0

# =========================
# Odoo configuration
# =========================
# Defaults requested by user
ODOO_URL=http://192.168.20.106:8069/
ODOO_DB=odoo

# Required credentials
ODOO_USERNAME=
ODOO_PASSWORD=

# Local state file path for Zoho -> Odoo id mappings
STATE_FILE_PATH=state/mappings.json

# Sync behavior flags (safe defaults: no deletes)
SYNC_CONTACTS_CREATE_MISSING=true
SYNC_CONTACTS_UPDATE_EXISTING=true
SYNC_PRODUCTS_CREATE_MISSING=true
SYNC_PRODUCTS_UPDATE_EXISTING=true
